<Project Sdk="Microsoft.NET.Sdk">

  <!-- Verification and measurement driver of the step2 paper (incremental MM3 upkeep).
       Shared settings come from the root Directory.Build.props; only the measurement
       configuration of the released MM3 harness (Mm3Paper) is restated here:
       no tiering ramp, no R2R stubs, server GC, concurrent GC off. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <NoWarn>$(NoWarn);CA2252</NoWarn>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Optimize>true</Optimize>
    <TieredCompilation>false</TieredCompilation>
    <TieredCompilationQuickJit>false</TieredCompilationQuickJit>
    <TieredCompilationQuickJitForLoops>false</TieredCompilationQuickJitForLoops>
    <PublishReadyToRun>false</PublishReadyToRun>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <RetainVMGarbageCollection>true</RetainVMGarbageCollection>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Incremental\Step2.Core.csproj" />
    <ProjectReference Include="..\..\src\Relations\Relations.csproj" />
    <ProjectReference Include="..\..\src\Meshing\Meshing.csproj" />
  </ItemGroup>

</Project>
