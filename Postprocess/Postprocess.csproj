<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <!-- Relations marks its public APIs [RequiresPreviewFeatures] in Release; opt in so this
         project (which consumes them) builds in Release too (otherwise CA2252). -->
    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <EnablePreviewFeatures>true</EnablePreviewFeatures>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\Meshing\Meshing.csproj" />
      <ProjectReference Include="..\Relations\Relations.csproj" />
    </ItemGroup>

</Project>
