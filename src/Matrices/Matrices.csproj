<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Numerical</RootNamespace>
    <!-- Vectorization / intrinsics hints (project-specific). -->
    <EnableAVX2>true</EnableAVX2>
    <EnableFMA>true</EnableFMA>
    <EnableSSE41>true</EnableSSE41>
    <EnableSSE42>true</EnableSSE42>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.ObjectPool" />
    <!-- Intel MKL native redist on Windows (Sparse BLAS + PARDISO). Linux/macOS use the
         system MKL, auto-detected by NativeLibraries.cs. -->
    <PackageReference Include="intelmkl.redist.win-x64" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Relations\Relations.csproj" />
  </ItemGroup>

</Project>
