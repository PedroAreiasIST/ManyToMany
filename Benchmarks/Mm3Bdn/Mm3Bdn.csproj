<Project Sdk="Microsoft.NET.Sdk">
  <!-- Standalone BenchmarkDotNet harness for MM3's connectivity queries.
       Run it to independently reproduce and ASSESS the MM3 numbers reported in
       README.md / the paper, with full statistics (mean, error, stddev, median,
       allocations). It generates the same synthetic meshes the Python harness
       uses, so no Python or external library is required.
       See Benchmarks/README.md for run commands and BenchmarkDotNet filters. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Relations marks its public API [RequiresPreviewFeatures]; opt in to consume it. -->
    <EnablePreviewFeatures>true</EnablePreviewFeatures>
    <Configurations>Debug;Release</Configurations>
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8"/>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Relations\Relations.csproj"/>
    <ProjectReference Include="..\..\Meshing\Meshing.csproj"/>
  </ItemGroup>
</Project>
