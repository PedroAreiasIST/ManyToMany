<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Relations marks its public API [RequiresPreviewFeatures]; opt in to consume it. -->
    <EnablePreviewFeatures>true</EnablePreviewFeatures>
    <Configurations>Debug;Release</Configurations>
    <!-- Steady-state measurement: fully-optimized code (no tier-0) and Server GC so
         the warm samples reflect MM3's real throughput, not JIT/GC warm-up. -->
    <TieredCompilation>false</TieredCompilation>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Relations\Relations.csproj" />
    <ProjectReference Include="..\..\Meshing\Meshing.csproj" />
  </ItemGroup>
</Project>
