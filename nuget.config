<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Pin nuget.org as the sole package source for reproducible restore.
       (Intel MKL redist for Windows is published on nuget.org.) -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
